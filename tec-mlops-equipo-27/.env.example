# Copia este archivo como .env y ajusta los valores. El archivo .env no se sube a Git.
# Servidor local de tracking con base de datos (necesario para el Model Registry):
#   make tracking  ->  mlflow server --backend-store-uri sqlite:///mlflow.db --host 127.0.0.1 --port 5000
# Si no se define, mibici.config usa http://127.0.0.1:5000.
# Nota: `mlflow run` no lee .env; en la terminal usar `export MLFLOW_TRACKING_URI=...`.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=mibici-equipo27
