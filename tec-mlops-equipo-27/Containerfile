FROM docker.io/library/python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    MODELO_RUTA=/opt/models/p1

WORKDIR /app

# Runtime support for numerical libraries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# requirements.txt includes "-e .", so package source and metadata
# must exist before installing it.
COPY requirements.txt pyproject.toml README.md LICENSE ./
COPY mibici/ ./mibici/

RUN python -m pip install -r requirements.txt \
    && python -m pip check

# Downloaded from the Model Registry before building.
COPY --chown=10001:10001 modelo_p1/ /opt/models/p1/

USER 10001:10001

# Fail the build if the packaged model cannot load or has the wrong signature.
RUN python -c "from mibici.api.modelo import Ajustes, cargar; cargar(Ajustes(ruta_local='/opt/models/p1'))"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "mibici.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
